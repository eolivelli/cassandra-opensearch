<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.cassandraopensearch</groupId>
    <artifactId>cassandra-opensearch-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>cassandra-opensearch-examples</artifactId>
  <packaging>pom</packaging>
  <name>Cassandra + OpenSearch :: Examples</name>
  <description>
    Documentation and runnable scripts only — no code, no artifact. Packaging is pom so the
    module joins the reactor, and so that the `bash -n` parse check below runs on every build,
    without producing a jar nobody would consume.

    The check is a parse, not a lint: it is `bash -n`, not shellcheck. shellcheck is not part of
    the build's tool contract (a Maven build has to work on a machine that has only a JDK), and a
    check that silently does nothing when the tool is absent is worse than one that is honest
    about its scope.

    A parse is also not enough. src/test/scripts/cluster-control-check.sh runs cluster-control.sh
    against a cluster of stub nodes and asserts what it does with their exit codes, which is
    where the defects have actually been: a `destroy` that refused to delete a cluster whose
    nodes were merely already stopped parsed perfectly well.
  </description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <!-- A shipped script that does not parse is worse than no script: the reader trusts
                 it. `bash -n` is not a substitute for running them, but it is free and catches
                 the edit that was never re-run. -->
            <id>syntax-check-example-scripts</id>
            <phase>test</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <apply executable="bash" failonerror="true" parallel="false">
                  <arg value="-n"/>
                  <fileset dir="${project.basedir}" includes="**/*.sh"/>
                </apply>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Behaviour, not syntax. The stub nodes it drives are the point: what is under test is how
        cluster-control.sh reads a launcher exit code, and a real node would make that slower,
        flakier and no more conclusive.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-example-scripts</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${project.basedir}/src/test/scripts/cluster-control-check.sh</executable>
              <arguments>
                <argument>${project.basedir}/local-cluster</argument>
                <argument>${project.build.directory}/script-check</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
