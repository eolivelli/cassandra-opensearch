<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.cassandraopensearch</groupId>
    <artifactId>cassandra-opensearch-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>cassandra-opensearch-spi</artifactId>
  <name>Cassandra + OpenSearch :: SPI</name>
  <description>
    The bridge contract shared between the supervisor and the isolated service runtimes.
    This module MUST have zero dependencies: every type declared here is loaded by the shared
    parent ClassLoader and is therefore visible inside both the Cassandra and the OpenSearch
    isolated ClassLoaders. Adding a dependency here would leak that dependency into both
    isolated worlds and defeat the isolation.
  </description>

  <!-- Deliberately no dependencies. See above; enforced below rather than by convention. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>spi-must-stay-dependency-free</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <banTransitiveDependencies>
                  <message>
                    The SPI module must have no compile or runtime dependencies. Its classes are
                    loaded by the shared parent ClassLoader, so anything added here is forced on
                    both the Cassandra and the OpenSearch isolated loaders and breaks isolation.
                  </message>
                </banTransitiveDependencies>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <!-- `provided` and `system` are on this list for the same reason as `compile`:
                       both put the type on the SPI's own compile classpath, so a class here can
                       reference it, and both then leave the supervisor to supply it at runtime —
                       which means supplying it on the parent loader, visible inside every
                       isolated loader. That is exactly the leak this module exists to prevent,
                       arrived at by a route that used to pass `validate` silently. -->
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>
                    No compile/runtime/provided/system dependency may be added to the SPI module.
                    Test-scoped dependencies are fine: they never reach the isolated loaders.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
