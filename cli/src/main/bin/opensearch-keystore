#!/bin/sh
#
# opensearch-keystore against this installation's conf/.
#
# A passthrough, and it has to be one: the keystore commands live in OpenSearch's
# distribution/tools/keystore-cli module, which is not part of the org.opensearch:opensearch
# dependency closure that lib/opensearch is assembled from. Only KeyStoreWrapper, the reader, is
# here. So the tool comes from an OpenSearch installation and this script contributes the two
# things that installation cannot know: which config directory to write into, and that the JDK
# has to be 21.
#
# Worth knowing before using it: the embedded node does not read conf/opensearch.keystore today.
# Loading secure settings is something org.opensearch.bootstrap.Bootstrap does, and this project
# deliberately never goes through Bootstrap - OpenSearchService builds its Environment through
# InternalSettingsPreparer with no secure settings. A keystore written here takes effect only
# once the runtime starts loading one.

set -e

CO_INCLUDE=$(dirname "$0")/cassandra-opensearch.in.sh
[ -r "$CO_INCLUDE" ] || { echo "opensearch-keystore: missing $CO_INCLUDE" >&2; exit 1; }
# shellcheck source=cassandra-opensearch.in.sh
. "$CO_INCLUDE"

co_require_java_21

if [ -n "$OPENSEARCH_TOOLS_HOME" ] && [ -x "$OPENSEARCH_TOOLS_HOME/bin/opensearch-keystore" ]; then
    OPENSEARCH_PATH_CONF="$CO_CONF"
    export OPENSEARCH_PATH_CONF
    exec "$OPENSEARCH_TOOLS_HOME/bin/opensearch-keystore" "$@"
fi

cat >&2 <<EOF
opensearch-keystore: not available in this distribution.

The keystore commands ship in OpenSearch's distribution/tools/keystore-cli, which is not part of
the org.opensearch:opensearch dependency closure that lib/opensearch is assembled from, so there
is no jar here to run.

Point OPENSEARCH_TOOLS_HOME at an OpenSearch installation of the same version as
$(basename "$(ls "$CO_HOME"/lib/opensearch/opensearch-[0-9]*.jar 2> /dev/null | head -1)")
and run this again; it will operate on $CO_CONF/opensearch.keystore.
EOF
exit 1
